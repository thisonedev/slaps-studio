{
  "name": "@studio/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-port.mjs && next dev --turbopack --port 3000",
    "dev:webpack": "node scripts/dev-port.mjs && next dev --port 3000",
    "prebuild": "node scripts/copy-install-sh.mjs && pnpm -w run build:packages && pnpm -w run check:constants && pnpm -w run check:colors && pnpm lint && pnpm check",
    "build": "next build",
    "build:dev": "next build",
    "start": "BASE_PATH=/slaps-studio node serve.mjs",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@studio/config": "workspace:*",
    "@studio/constants": "workspace:*",
    "@studio/core": "workspace:*",
    "@studio/ui": "workspace:*",
    "@studio/validation": "workspace:*",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
