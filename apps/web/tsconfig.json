{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@studio/ui": ["../../packages/ui/dist"],
      "@studio/core": ["../../packages/core/dist"],
      "@studio/validation": ["../../packages/validation/dist"],
      "@studio/config": ["../../packages/config"]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-dev", "out"]
}
